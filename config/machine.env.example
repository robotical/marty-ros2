# Copy to machine.env. Loaded by scripts/setup_env.sh in each Bash terminal.
# The workspace defaults to this checkout, regardless of the current directory.
# ROS_WORKSPACE="$HOME/ros2_ws"
ROS_SETUP_FILE=/opt/ros/jazzy/setup.bash
ROS_DOMAIN_ID=0
MARTY_PYTHON_VENV="$MARTY_ROS_ROOT/.venv"
MARTY_ROS_ROBOTS_FILE="$MARTY_ROS_ROOT/config/robots.yaml"
